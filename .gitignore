# Dependencies
**/node_modules/

# Production/Build outputs
**/dist/
**/dist-ssr/
**/out/

# Stacks / Clarinet Caches & Settings
**/.cache/
**/settings/Mainnet.toml
**/settings/Testnet.toml
**/costs-reports.json
**/history.txt

# Logs and Debug files
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# Coverage and testing reports
**/coverage/
**/playwright-report/
**/test-results/
**/*.info

# Editor directories and system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Environment Variables (NEVER commit these)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env.*
!**/.env.example

# TxGuard demo outputs and local media (keep editable sources and metadata tracked)
# These paths stay on disk; original footage and delivery archives need separate backups.
/media/txguard-demo/art/
/media/txguard-demo/render/
/media/txguard-demo/audio/*.wav
/media/txguard-demo/source/*.png
/media/txguard-demo/source/*.webm
/media/txguard-demo/source/raw/
/media/txguard-demo/review/*.jpg
/media/txguard-demo/review/*.png
/media/txguard-demo/deliverables/*.mp4
/media/txguard-demo/deliverables/*.wav
/media/txguard-demo/deliverables/*.png
/media/txguard-demo/deliverables/*.zip
