# SERVER ONLY. Copy to .env.local for development; never use VITE_ prefixes.
# Etherscan V2 key: enables Ethereum (1) / BNB Chain (56) native balance and history.
# The account plan must support balance, txlist and tokentx on both networks.
ETHERSCAN_API_KEY=
# Optional explanation focus; deterministic explanations work without Groq.
GROQ_API_KEY=

# REQUIRED for Vercel APIs. Existing Upstash Redis REST endpoint and WRITE token.
# No infrastructure is created by this app. Do not use the read-only token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate at least 32 random characters; keep identical across all function instances.
RATE_LIMIT_HMAC_SECRET=
# Optional Vercel KV aliases: use this complete pair OR the Upstash pair, not a mix.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional shared app/AI request ceilings per fixed 60-second window.
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_AI_GLOBAL_PER_MINUTE=30
# Same-origin access is also checked against the actual request host.
APP_ORIGIN=http://localhost:5173
